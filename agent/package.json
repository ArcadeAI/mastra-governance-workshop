{
  "name": "mastra-governance-workshop-agent",
  "private": true,
  "type": "module",
  "description": "A Mastra agent that finds its tools with Arcade's Tool Rec and calls them through Arcade, governed by your policy and checked by Jev.",
  "scripts": {
    "dev": "mastra dev",
    "signin": "bun run signin.ts",
    "ask": "bun run ask.ts",
    "tools": "bun run tools.ts",
    "jev": "bun run jev.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --no-env-file test"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3.0.33",
    "@arcadeai/arcadejs": "2.4.1",
    "@mastra/core": "^1.69.0",
    "@mastra/libsql": "^1.27.0",
    "@mastra/observability": "^1.21.0",
    "ai": "^7.0.112",
    "jose": "6.2.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "mastra": "^1.35.0",
    "typescript": "^6.0.3"
  }
}
